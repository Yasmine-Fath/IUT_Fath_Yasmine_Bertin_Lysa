<Window x:Class="Robot_interface_fath_bertin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Robot_interface_fath_bertin"
        xmlns:oscillo="clr-namespace:WpfOscilloscopeControl_NS;assembly=WpfOscilloscopeControl"
        xmlns:AsservDisplay="clr-namespace:WpfAsservissementDisplay_NS;assembly=WpfAsservissementDisplay"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!--<GroupBox Header="Réception" Grid.Column="1" Grid.Row="0" Margin="5">
            <TextBox x:Name="textBoxReception" TextWrapping="Wrap" Text="" TextChanged="TextBox_TextChanged" IsReadOnly="True" AcceptsReturn="True"/>
        </GroupBox>
        <GroupBox Header="Émission" Grid.Column="0" Grid.Row="0" Margin="5">
            <TextBox x:Name="textBoxEmission" TextWrapping="Wrap" Text="" AcceptsReturn="True" PreviewKeyDown="TextBoxEmission_PreviewKeyDown"/>
        </GroupBox>-->

        <local:RobotPositionInterface x:Name="robotPositionInterface" Width="500" Height="500"/>



        <StackPanel  Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="2" HorizontalAlignment="Center">
            <Button x:Name="buttonEnvoyer" Grid.Column="1" Content="Envoyer" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Center" Width="100" Height="20" Click="buttonEnvoyer_Click" Margin="5" />
            <Button x:Name="buttonClear" Grid.Column="3" Content="Clear" HorizontalAlignment="Center" Grid.Row="3" VerticalAlignment="Center" Width="100" Height="20" Click="buttonClear_Click" Margin="5"/>
            <Button x:Name="buttonTest" Grid.Column="1" Content="Test" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Center" Width="100" Height="20" Click="buttonTest_Click"  Margin="5"/>
            <!--//04/09   pour espace ghost-->
            <!--<Button x:Name="buttonAuto" Grid.Column="1" Content="Auto" HorizontalAlignment="Left" Grid.Row="3" VerticalAlignment="Center" Width="100" Height="20" Click="buttonAuto_Click"  Margin="5"/>-->

        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2">
            <GroupBox Header="Leds" Margin="5">
                <StackPanel Orientation="Vertical" >
                    <CheckBox x:Name="checkBoxLed1" Content="Led1" Margin="5"/>
                    <CheckBox Name="checkBoxLed2" Content="Led2" Margin="5" />
                    <CheckBox Name="checkBoxLed3" Content="Led3" Margin="5" />
                </StackPanel>
            </GroupBox>
            <!--<GroupBox Header="Télèmetres IR" Margin="5">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock x:Name="TextBoxIRGauche" Text ="IR Gauche : " Margin="5"/>
                    <TextBlock x:Name="TextBoxIRCentre" Text="IR Centre : " Margin="5"/>
                    <TextBlock x:Name="TextBoxIRDroit" Text="IR Droit : " Margin="5"/>
                </StackPanel>
            </GroupBox>-->
            <GroupBox Header="Orientation" Grid.Column="2" Grid.Row="0" Margin="5">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock x:Name="TextBoxXGhostOrientation" Text ="xG : " Margin="5"/>
                    <TextBlock x:Name="TextBoxYGhostOrientation" Text="yG : " Margin="5"/>
                    <TextBlock x:Name="TextBoxAngleThetaGhost" Text="ThetaG : " Margin="5"/>
                    <TextBlock x:Name="TextBoxXWayPointOrientation" Text ="xWP : " Margin="5"/>
                    <TextBlock x:Name="TextBoxYWayPointOrientation" Text="yWP : " Margin="5"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Moteurs" Margin="4">
                <StackPanel Orientation="Vertical" Margin="0">
                    <TextBlock x:Name="TextBoxVitesseGauche" Text ="Vitesse Gauche : " Margin="5"/>
                    <TextBlock x:Name="TextBoxVitesseDroit" Text="Vitesse Droit : " Margin="5"/>
                </StackPanel>
            </GroupBox>
            <!--//04/09   pour espace ghost-->
            <!--<GroupBox Header="Mode" Margin="5">
                <StackPanel Orientation="Vertical" >
                    <CheckBox x:Name="checkBoxModeM" Content="Manuel" Margin="5"/>
                    <CheckBox x:Name="checkBoxModeA" Content="Auto" Margin="5"/>
                </StackPanel>
            </GroupBox>-->
            <GroupBox Header="Position" Margin="5">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock x:Name="TextBoxXPosition" Text ="x : " Margin="5"/>
                    <TextBlock x:Name="TextBoxYPosition" Text="y : " Margin="5"/>
                    <TextBlock x:Name="TextBoxAnglePosition" Text="Angle : " Margin="5"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Vitesse" Margin="5">
                <StackPanel Orientation="Vertical" Margin="5">
                    <TextBlock x:Name="TextBoxVitesseLineaire" Text ="VL : " Margin="5"/>
                    <TextBlock x:Name="TextBoxVitesseAngulaire" Text="VA : " Margin="5"/>
                </StackPanel>
            </GroupBox>




        </StackPanel>

        <Button x:Name="buttonUnitaire0" Grid.Column="2" Content="Point 0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="20" Click="buttonUnitaire0_Click"/>
        <Button x:Name="buttonUnitaire1" Grid.Column="2" Content="Point 1,0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="100" Height="20" Click="buttonUnitaire1_Click"  Margin="157,0,0,0"/>
        <Button x:Name="buttonUnitaire2" Grid.Column="2" Content="Point 0,1" HorizontalAlignment="Center" VerticalAlignment="Top" Width="100" Height="20" Click="buttonUnitaire2_Click"  Margin="0,10,0,0"/>
        <Button x:Name="buttonUnitaire3" Grid.Column="2" Content="Point -1,0" HorizontalAlignment="Left" VerticalAlignment="Center" Width="100" Height="20" Click="buttonUnitaire3_Click"  Margin="10,0,0,0"/>
        <Button x:Name="buttonUnitaire4" Grid.Column="2" Content="Point 0,-1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Width="100" Height="20" Click="buttonUnitaire4_Click"  Margin="0,174,0,0"/>



        <!--<oscillo:WpfOscilloscope Grid.Column="2" x:Name="oscilloSpeed" />-->
        <AsservDisplay:AsservissementRobot2RouesDisplayControl Grid.Column="2"  Grid.Row="2" x:Name="asservSpeedDisplay"/>

    </Grid>
</Window>
